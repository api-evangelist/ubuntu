{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ubuntu Security CVE Bugs Info API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
