{
  "opencollection": "1.0.0",
  "info": {
    "name": "Launchpad REST API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "People",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List People",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.launchpad.net/1.0/people",
            "params": [
              {
                "name": "ws.op",
                "value": "",
                "type": "query",
                "description": "Named operation to perform on the collection."
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query string for people."
              },
              {
                "name": "ws.start",
                "value": "",
                "type": "query",
                "description": "Starting offset for pagination."
              },
              {
                "name": "ws.size",
                "value": "",
                "type": "query",
                "description": "Number of items to return."
              }
            ]
          },
          "docs": "Returns a collection of people and teams registered in Launchpad."
        },
        {
          "info": {
            "name": "Get Person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.launchpad.net/1.0/~:person_name",
            "params": [
              {
                "name": "person_name",
                "value": "",
                "type": "path",
                "description": "Launchpad username or team name."
              }
            ]
          },
          "docs": "Returns information about a specific Launchpad person or team."
        }
      ]
    },
    {
