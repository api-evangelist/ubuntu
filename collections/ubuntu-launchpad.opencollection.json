                "description": "Unique bug identifier."
              }
            ]
          },
          "docs": "Returns details for a specific Launchpad bug."
        },
        {
          "info": {
            "name": "Update Bug",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.launchpad.net/1.0/bugs/:bug_id",
            "params": [
              {
                "name": "bug_id",
                "value": "",
                "type": "path",
                "description": "Unique bug identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a bug's fields such as title, description, or status."
        }
