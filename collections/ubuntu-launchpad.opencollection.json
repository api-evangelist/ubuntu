          },
          "http": {
            "method": "GET",
            "url": "https://api.launchpad.net/1.0/bugs",
            "params": [
              {
                "name": "ws.op",
                "value": "",
                "type": "query",
                "description": "Named operation to perform."
              },
              {
                "name": "status",
