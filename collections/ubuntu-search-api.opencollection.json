{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ubuntu Security CVE Bugs Search API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Snaps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ubuntu.com/security/v2/snaps/search",
            "headers": [
              {
                "name": "Snap-Device-Series",
                "value": ""
              },
              {
                "name": "User-Agent",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query string."
              },
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Filter by snap category."
              },
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "Search scope. Use 'wide' for cross-store search."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response."
              }
            ]
          },
          "docs": "Search for snaps in the Snap Store by name, keyword, or category."
        }
      ]
    }
  ],
  "bundled": true
}